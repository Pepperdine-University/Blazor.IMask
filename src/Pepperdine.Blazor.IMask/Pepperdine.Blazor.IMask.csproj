<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <PackageId>Pepperdine.Blazor.IMask</PackageId>
    <AssemblyName>Pepperdine.Blazor.IMask</AssemblyName>
    <RootNamespace>Pepperdine.Blazor.IMask</RootNamespace>
    <Version>1.0.0</Version>
    <Company>Pepperdine University</Company>
    <Description>Add IMask.js input masking to Blazor and ASP.NET Core fields.</Description>
    <PackageTags>blazor;aspnetcore;imask;inputmask;masking;razor</PackageTags>
    <PackageIcon>Blazor.IMask.png</PackageIcon>
    <RepositoryUrl>https://github.com/Pepperdine-University/Blazor.IMask</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <MicrosoftPackageVersion>8.0.0</MicrosoftPackageVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <MicrosoftPackageVersion>9.0.0</MicrosoftPackageVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <MicrosoftPackageVersion>10.0.0</MicrosoftPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Components" Version="$(MicrosoftPackageVersion)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(MicrosoftPackageVersion)" />
    <PackageReference Include="Microsoft.JSInterop" Version="$(MicrosoftPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Blazor.IMask.png" Pack="true" PackagePath="" />
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="" />
    <Content Update="wwwroot\vendor\LICENSE.imask.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
